VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO top_century_clock
  CLASS BLOCK ;
  FOREIGN top_century_clock ;
  ORIGIN 0.000 0.000 ;
  SIZE 700.000 BY 850.000 ;
